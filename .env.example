# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=TaskVibe

# Dedicated TaskVibe MongoDB database (never reuse SocialPromo credentials/data)
MONGODB_URI=
MONGODB_DB=taskvibe

# Gmail SMTP (no Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Independent Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Authentication secrets: generate unique random values for each environment
AUTH_SECRET=
OTP_SECRET=

# BEP-20 USDT deposits: public RPC and verified token contract address must be configured
BSC_RPC_URL=
USDT_BEP20_CONTRACT=
BSC_CONFIRMATIONS=15
DEPOSIT_WALLET_ADDRESS=

# Withdrawal signing must be handled by a dedicated secure signer, never a browser variable
WITHDRAWAL_SIGNER_URL=
WITHDRAWAL_SIGNER_TOKEN=
